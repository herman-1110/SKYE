# Path to Firebase Admin SDK service account JSON key file
FIREBASE_KEY_PATH=./serviceAccountKey.json

# Realtime Database URL — used for /positions and /alerts (sub-100ms latency)
FIREBASE_RTDB_URL=your-firebase-rtdb-url

# Google Gemini API key — required when LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# LLM provider selection — change this one var to switch models, no code changes needed
LLM_PROVIDER=gemini                  # active provider: gemini | openai | ollama | claude
LLM_MODEL_NAME=gemini-3.1-flash-lite # model name passed to the active provider
ANTHROPIC_API_KEY=                   # required only if LLM_PROVIDER=claude
OPENAI_API_KEY=                      # required only if LLM_PROVIDER=openai
OLLAMA_HOST=http://localhost:11434   # required only if LLM_PROVIDER=ollama

# Uvicorn HTTP server port
PORT=8000

# Enable uvicorn reload mode — set to false in production
DEBUG=false

# Shared secret token that the Omada Controller sends as a Bearer token on /telemetry
OMADA_ACCESS_TOKEN=your-omada-access-token-here

# Print the full raw per-AP Omada payload to stdout on every ingest — deep-debug only.
# Contains box-drawing characters that crash piped stdout under Windows' default cp1252
# codepage unless PYTHONIOENCODING=utf-8 is set. Leave false for normal operation/demo.
OMADA_RAW_DUMP_ENABLED=false

# LDPL path-loss exponent n: 2.0 = free space, 2.5–3.5 = indoor with obstacles
PATH_LOSS_EXPONENT=2.5

# Calibrated TX power (RSSI at 1 m) for Minew BLE beacons, in dBm
TX_POWER_DEFAULT=-59

# Radius (m) within which a guard's position counts as "at" a patrol checkpoint (AP) — uncalibrated
PATROL_PROXIMITY_RADIUS_M=1.0

# Extra distance (m) beyond PATROL_PROXIMITY_RADIUS_M before an entered checkpoint
# counts as departed — enter-at-radius / exit-at-radius+margin hysteresis, uncalibrated
PATROL_PROXIMITY_EXIT_MARGIN_M=0.5

# Minutes a beacon must remain stationary in a high-risk zone before man-down fires (FR3)
MAN_DOWN_MINUTES=5

# Radius (m) within which a person counts as "not moving" for man-down
MAN_DOWN_MOVEMENT_EPSILON_M=2.0

# Seconds a beacon's last position may go un-updated before a signal-loss man-down fires
MAN_DOWN_STALE_SECONDS=120.0

# Upper bound (seconds): a /positions record older than this is treated as dead, not an active incident
MAN_DOWN_STALE_MAX_AGE_S=3600.0

# Minimum distance (metres) that counts as movement for man-down detection
COLLISION_DISTANCE_M=2.0

# Seconds ahead for Kalman prediction to check collision convergence (FR4)
COLLISION_ALERT_SECONDS=3

# Minimum dwell time (seconds) required at a checkpoint to pass patrol compliance (FR5)
MIN_DWELL_SECONDS=30

# Gaussian noise std-dev (dB) added to simulated RSSI — models multipath / obstacle variance
RSSI_NOISE_STD=3.0

# RSSI floor (dBm) below which the single-AP proximity fallback treats a beacon as gone
PROXIMITY_RSSI_FLOOR=-90.0

# Seconds a recent exact solve outranks a fresh approximate estimate for the same beacon — uncalibrated
POSITION_EXACT_HOLD_SECONDS=10.0

# Minimum cosine similarity (0-1) for a retrieved feedback example to be surfaced
# in audit report context — uncalibrated, see settings.py
RAG_SIMILARITY_FLOOR=0.5
